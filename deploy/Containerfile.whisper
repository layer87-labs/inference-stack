# syntax=docker/dockerfile:1
#
# Containerfile.whisper — Whisper ASR HTTP server (CPU), model baked in
#
# OpenAI-compatible POST /v1/audio/transcriptions (and /v1/audio/translations)
# served by deploy/whisper/server.py on top of faster-whisper (CTranslate2).
#
# Why a purpose-built server instead of an off-the-shelf ASR web service:
#   - the router forwards OpenAI-style paths unchanged, so the backend must
#     speak that API itself;
#   - /health is served independently of inference, so a probe never queues
#     behind a long transcription.
#
# Model is baked into the image (large-v3-turbo, ~1.6 GB) and loaded from a
# local path — the container runs fully offline and needs no PVC.
#
# Hardened: non-root (uid 1000), no network access needed at runtime,
# ctranslate2 4.x ships a non-executable stack, so the default seccomp
# profile and allowPrivilegeEscalation=false work.

FROM python:3.12-slim

ARG WHISPER_MODEL=large-v3-turbo

# av is pinned: faster-whisper 1.2.x breaks with newer PyAV major versions
# ("open() got an unexpected keyword argument 'metadata_errors'").
RUN pip install --no-cache-dir \
    "faster-whisper==1.2.1" \
    "av==16.1.0" \
    "fastapi>=0.110.0" \
    "uvicorn[standard]>=0.27.0" \
    "python-multipart>=0.0.9"

RUN groupadd -g 1000 whisper && \
    useradd -u 1000 -g whisper -m -s /bin/bash whisper && \
    mkdir -p /opt/model && chown whisper:whisper /opt/model

# Bake the model (needs network at build time only).
USER 1000
RUN python -c "from faster_whisper.utils import download_model; download_model('${WHISPER_MODEL}', output_dir='/opt/model')" && \
    rm -rf /home/whisper/.cache

WORKDIR /app
COPY --chown=1000:1000 deploy/whisper/server.py /app/server.py

ENV MODEL_PATH=/opt/model \
    MODEL_NAME=whisper-${WHISPER_MODEL} \
    COMPUTE_TYPE=int8 \
    HF_HUB_OFFLINE=1 \
    PORT=9000

EXPOSE 9000

HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=8 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:9000/health')" || exit 1

CMD ["python", "/app/server.py"]

LABEL org.opencontainers.image.source="https://github.com/layer87-labs/inference-stack"
LABEL org.opencontainers.image.description="Whisper ASR HTTP server (CPU) — OpenAI-compatible /v1/audio/transcriptions, model baked in"
